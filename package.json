{
  "name": "arteria-studio",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/verify-image-config.js",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postbuild": "next-sitemap",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "prepare": "husky install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@darkroom.engineering/hamo": "^0.6.46",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-accordion": "^1.1.2",
    "@studio-freight/compono": "^0.0.42",
    "@studio-freight/react-lenis": "0.0.40",
    "@studio-freight/tempus": "0.0.38",
    "@theatre/core": "^0.7.0",
    "@theatre/studio": "^0.7.0",
    "@vercel/analytics": "^1.1.1",
    "blaze-slider": "1.9.3",
    "clsx": "^2.1.0",
    "events": "^3.3.0",
    "gsap": "^3.12.4",
    "idb-keyval": "^6.2.1",
    "jsonminify": "^0.4.2",
    "next": "^14.2.33",
    "next-sitemap": "^4.2.3",
    "prisma": "^6.19.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-use": "^17.4.2",
    "sass": "^1.69.7",
    "sharp": "^0.33.5",
    "throttle-debounce": "5.0.0",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.0.4",
    "@svgr/webpack": "^8.1.0",
    "cross-env": "^7.0.3",
    "eslint": "8.56.0",
    "eslint-config-next": "^14.2.33",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1"
  },
  "overrides": {
    "@studio-freight/hamo": "npm:@darkroom.engineering/hamo@^0.6.46",
    "react-is": "18.2.0",
    "throttle-debounce": "5.0.0"
  },
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.{js,css,scss,md}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "@studio-freight/hamo": "npm:@darkroom.engineering/hamo@^0.6.46",
      "react-is": "18.2.0",
      "throttle-debounce": "5.0.0"
    }
  }
}
