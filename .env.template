# Copy to .env and fill in values for local development.

# Local Postgres (use localhost, not the placeholder "host")
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arteria?schema=public"

WEBSITE_URL="http://localhost:3000"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Vercel Blob — Storage → Blob → link store to project.
# On Vercel you get BLOB_STORE_ID (+ VERCEL_OIDC_TOKEN automatically).
# BLOB_WEBHOOK_PUBLIC_KEY is used for upload callbacks.
# BLOB_READ_WRITE_TOKEN is optional (legacy / non-Vercel hosts only).
# Local: `vercel env pull .env.local`
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
BLOB_READ_WRITE_TOKEN=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
